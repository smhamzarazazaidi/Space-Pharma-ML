# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Experiment logs and temp files
*.log
scratch/
tmp/
temp/

# Large Model Binaries (keep lightweight / code versioned)
models/*.pkl
models/*.joblib
models/*.onnx
models/*.pt
models/*.pth
!models/.gitkeep

# Large / Raw Datasets (Raw data should be stored with provenance, large binaries ignored if >100MB)
data/raw/space_radiation/*.csv
# Note: Do not ignore .gitkeep files in data subdirectories
!data/**/.gitkeep
